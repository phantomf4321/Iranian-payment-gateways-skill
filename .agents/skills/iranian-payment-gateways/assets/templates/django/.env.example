# Inert UUID for format checks only. Replace using your backend's secret store.
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true
PAYMENT_CALLBACK_URL=https://example.com/payments/callback/
PAYMENT_CURRENCY=IRR
# Local policy, not certified gateway limits; confirm your terminal's limits.
PAYMENT_MIN_AMOUNT_IRR=10000
PAYMENT_MAX_AMOUNT_IRR=1000000000000
# Django hook import paths are settings, not environment magic; wire them explicitly.
PAYMENTS_ORDER_LOADER=shop.payment_hooks.load_order
PAYMENTS_FULFILL=shop.payment_hooks.fulfill
